---
interface NavLink {
  href: string;
  label: string;
}

interface Props {
  links?: NavLink[];
}

const { links = [
  { href: '#services', label: 'Capabilities' },
  { href: '#approach', label: 'Approach' },
  { href: '#work', label: 'Selected work' },
  { href: '#gallery', label: 'Gallery' }
] } = Astro.props;
---

<button type="button" data-menu-toggle class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu">Menu <span class="menu-icon" aria-hidden="true">+</span></button>

<div id="mobile-menu" data-menu-drawer inert aria-hidden="true" class="pointer-events-none fixed inset-0 z-30 opacity-0 transition-opacity duration-200 ease-editorial motion-reduce:transition-none">
  <button type="button" data-menu-overlay class="absolute inset-0 bg-carbon-black/60 opacity-0 transition-opacity duration-200 ease-editorial motion-reduce:transition-none" aria-label="Close menu"></button>
  <nav data-menu-panel aria-label="Mobile navigation" class="absolute right-0 top-0 flex h-full w-[min(88vw,420px)] translate-x-full flex-col border-l border-mist-gray bg-bone-cream px-6 pb-[max(2rem,env(safe-area-inset-bottom))] pt-[max(24px,env(safe-area-inset-top))] text-carbon-black transition-[translate] duration-250 ease-editorial motion-reduce:transition-none md:px-10">
    <div class="flex items-center justify-between border-b border-mist-gray pb-5">
      <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-graphite">Navigate</span>
      <button type="button" data-menu-close class="grid h-11 w-11 place-items-center rounded-full border border-carbon-black text-xl leading-none outline-none transition-[background-color,color,transform] duration-150 ease-editorial hover:bg-carbon-black hover:text-bone-cream focus-visible:ring-2 focus-visible:ring-forest-ink active:scale-[0.97] motion-reduce:transition-none" aria-label="Close navigation">×</button>
    </div>
    <div class="flex flex-1 flex-col justify-center gap-6">
      {links.map((link) => <a data-menu-link href={link.href} class="text-4xl font-light tracking-[-0.06em] outline-none transition-[color,translate] duration-200 ease-editorial hover:translate-x-1 hover:text-stone-taupe focus-visible:text-stone-taupe motion-reduce:transition-none">{link.label}</a>)}
      <button data-menu-link data-inquiry-open type="button" class="w-fit text-left text-4xl font-light tracking-[-0.06em] outline-none transition-[color,translate] duration-200 ease-editorial hover:translate-x-1 hover:text-stone-taupe focus-visible:text-stone-taupe motion-reduce:transition-none">Start a conversation</button>
    </div>
    <p class="m-0 border-t border-mist-gray pt-5 font-mono text-[10px] uppercase tracking-[0.1em] text-graphite">Chennai · India / Dun Digital</p>
  </nav>
</div>

<script>
  const toggles = document.querySelectorAll<HTMLElement>('[data-menu-toggle]');
  const primaryToggle = toggles[0];
  const drawer = document.querySelector<HTMLElement>('[data-menu-drawer]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const overlay = document.querySelector<HTMLElement>('[data-menu-overlay]');
  const close = document.querySelector<HTMLElement>('[data-menu-close]');
  const links = document.querySelectorAll<HTMLElement>('[data-menu-link]');
  let lastFocused: HTMLElement | null = null;

  const isOpen = () => primaryToggle?.getAttribute('aria-expanded') === 'true';

  const setMenu = (open: boolean) => {
    if (!drawer || !panel || !overlay) return;
    toggles.forEach((toggle) => toggle.setAttribute('aria-expanded', String(open)));
    drawer.setAttribute('aria-hidden', String(!open));
    drawer.inert = !open;
    drawer.classList.toggle('pointer-events-none', !open);
    drawer.classList.toggle('opacity-0', !open);
    drawer.classList.toggle('opacity-100', open);
    overlay.classList.toggle('opacity-0', !open);
    overlay.classList.toggle('opacity-100', open);
    panel.classList.toggle('translate-x-full', !open);
    panel.classList.toggle('translate-x-0', open);
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) close?.focus(); else lastFocused?.focus();
  };

  toggles.forEach((toggle) => toggle.addEventListener('click', () => {
    const open = isOpen();
    if (!open) lastFocused = document.activeElement as HTMLElement;
    setMenu(!open);
  }));
  close?.addEventListener('click', () => setMenu(false));
  overlay?.addEventListener('click', () => setMenu(false));
  links.forEach((link) => link.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isOpen()) setMenu(false);
  });
</script>

<style>
  /* The header hamburger is retired: the thumb dock owns menu access on mobile. */
  .menu-toggle { display:none !important; touch-action:manipulation; }
  .menu-icon { font-size:20px; line-height:1; }
</style>
