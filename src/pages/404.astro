---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Page not found" description="The page you are looking for has moved or never existed. Head back to the Dun Digital home page." activePath="" noindex={true}>
  <section class="notfound">
    <div class="notfound-inner">
      <div class="notfound-numeral" aria-hidden="true">404</div>
      <h1>Lost the <em>signal.</em></h1>
      <p>The page you are after has moved or never existed. Head back and start from the top.</p>
      <a class="button button-outline" href="/">Back to the start</a>
    </div>
  </section>
</SiteLayout>
