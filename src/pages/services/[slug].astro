---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { Picture } from 'astro:assets';
import { services } from '../../data/content';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
---

<SiteLayout title={service.title} description={service.intro} activePath="/services">
  <div data-inner-page>
    <section class="page-hero section-wrap">
      <span class="page-index" aria-hidden="true">{service.number}</span>
      <div class="breadcrumbs motion-reveal"><ol><li><a href="/">Home</a></li><li>/</li><li><a href="/services/">Services</a></li><li>/</li><li aria-current="page">{service.title}</li></ol></div>
      <div class="motion-reveal" style="--motion-delay:80ms"><h1>{service.title}</h1><p class="page-lede">{service.intro}</p></div>
    </section>

    <section class="case-detail section-wrap motion-section"><div class="case-detail-image motion-reveal"><Picture fallbackFormat="webp" src={service.image} alt={`${service.title} campaign work`} loading="eager" decoding="async" widths={[640, 1024]} sizes="(max-width: 768px) 100vw, 55vw" formats={['avif', 'webp']} data-case-detail-img /><span class="case-detail-label">{service.category} · No. {service.number}</span><b>SVC / {service.number}</b></div><div class="case-detail-copy motion-reveal"><h2>Make it useful.</h2><p>{service.detail}</p><p>We bring the right level of thinking, making and measurement around the job, without adding layers for the sake of it.</p><button type="button" class="button button-outline" data-inquiry-open>Start a conversation</button></div></section>

    <section class="deliverables section-wrap motion-section"><div class="deliverables-grid"><div class="deliverables-intro motion-reveal"><h2>From first idea to useful output.</h2><p>A practical scope that can be shaped around the brief and the team already in the room.</p></div><div class="deliverable-list motion-reveal">{service.deliverables.map((deliverable, index) => <div class="deliverable-row"><span>0{index + 1}</span><strong>{deliverable}</strong></div>)}</div></div><div class="deliverable-outcome motion-reveal"><span>The outcome</span><p>{service.outcome}</p></div><div class="deliverable-outcome motion-reveal"><span>Delivered for</span><p>{service.deliveredFor}</p></div></section>

    <section class="cta-teaser section-wrap motion-reveal"><h2>Make the work move.</h2><p>Tell us what you are building, launching or changing. We will bring the right mix of people and channels to the table.</p><button type="button" class="button button-outline" data-inquiry-open>Start a conversation</button></section>
  </div>
</SiteLayout>

<script>
  document.querySelectorAll<HTMLImageElement>('[data-case-detail-img]').forEach((img) => {
    const reveal = () => img.classList.add('is-loaded');
    if (img.complete && img.naturalWidth > 0) reveal();
    else {
      img.addEventListener('load', reveal, { once: true });
      img.addEventListener('error', () => img.remove(), { once: true });
    }
  });
</script>
