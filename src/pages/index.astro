---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getImage } from 'astro:assets';
import { services, cases, industries } from '../data/content';
import gRagam0 from '../assets/gallery/ragam/image0.jpeg';
import gRagam1 from '../assets/gallery/ragam/image1.jpeg';
import gRagam3 from '../assets/gallery/ragam/image3.jpeg';
import gRagam4 from '../assets/gallery/ragam/image4.jpeg';
import gGuntupalli0 from '../assets/gallery/guntupalli/image0.jpeg';
import gGuntupalli2 from '../assets/gallery/guntupalli/image2.jpeg';
import gGuntupalli3 from '../assets/gallery/guntupalli/image3.jpeg';
import gGuntupalli5 from '../assets/gallery/guntupalli/image5.jpeg';
import gComfort0 from '../assets/gallery/comfort-point/image0.jpeg';
import gComfort1 from '../assets/gallery/comfort-point/image1.jpeg';
import gSummit0120 from '../assets/gallery/textile-summit/PHOTO-2026-01-20-08-10-39.jpg';
import gSummit0102 from '../assets/gallery/textile-summit/PHOTO-2026-01-02-17-00-15.jpg';
import gSummit0116 from '../assets/gallery/textile-summit/PHOTO-2026-01-16-13-46-16.jpg';
import gSummit0117 from '../assets/gallery/textile-summit/PHOTO-2026-01-17-23-16-55.jpg';
import gIgs0 from '../assets/gallery/igs/image0.jpeg';
import gIplas0317 from '../assets/gallery/iplas/PHOTO-2026-03-17-10-48-27.jpg';

const galleryFrames = [
  { label: 'Brand systems', client: 'Raagam Polymound', title: 'Identity, end to end', caption: 'Logos, guidelines and collaterals built as one system for a polymer manufacturer.', image: gRagam0 },
  { label: 'Social & content', client: 'Raagam Polymound', title: 'Calendars that move', caption: 'Always-on content built for distributors and industrial buyers.', image: gRagam3 },
  { label: 'Social & content', client: 'Guntupalli Marbles', title: 'A presence with rhythm', caption: 'Retainer content planned a month ahead, with room to react to festivals.', image: gGuntupalli0 },
  { label: 'Product creatives', client: 'Guntupalli Marbles', title: 'Shot for the feed', caption: 'Product-first social creatives from an always-on engagement.', image: gGuntupalli5 },
  { label: 'PR & hampers', client: 'Comfort Point', title: 'Stories that land', caption: 'Press outreach, gifting and launch coordination as one motion.', image: gComfort0 },
  { label: 'PR & hampers', client: 'Comfort Point', title: 'A memorable touchpoint', caption: 'Hamper campaigns designed to open doors with media and stakeholders.', image: gComfort1 },
  { label: 'Live events', client: 'Industry summit', title: 'Captured live', caption: 'On-ground coverage for industry-body summits and exhibitions.', image: gSummit0120 },
  { label: 'Live events', client: 'Industry summit', title: 'One coordinated sprint', caption: 'Branding, live updates and speaker content carrying a single voice.', image: gSummit0102 },
  { label: 'Social & content', title: 'Platform-native work', caption: 'Selected campaign creatives built for the formats people actually watch.', image: gIgs0 },
  { label: 'Campaign creatives', title: 'Made for the moment', caption: 'Selected occasion-led creatives from recent months of client work.', image: gIplas0317 }
];

const method = [
  { step: '01', name: 'Discover', note: 'Audit the brand, audience and landscape.' },
  { step: '02', name: 'Strategize', note: 'Channel plan and benchmark targets.' },
  { step: '03', name: 'Create', note: 'Branding, content and collaterals.' },
  { step: '04', name: 'Amplify', note: 'Paid media, influencer and PR, live.' },
  { step: '05', name: 'Report', note: 'Performance readout against benchmarks.' }
];

import CapabilityList from '../components/CapabilityList.astro';
import CaseStudyGrid from '../components/CaseStudyGrid.astro';
import GallerySection from '../components/GallerySection.astro';
---

<SiteLayout title="One agency. Every channel." description="Dun Digital · one accountable team for branding, social, advertising, websites, PR, shoots and live events." activePath="/">
  <section class="hero section-wrap">
    <div class="hero-copy reveal">
      <span class="sticker"><svg class="tick" aria-hidden="true"><use href="#i-spark" /></svg>Chennai studio · since 2024</span>
      <span class="sticker sticker-lime">Now booking Q1 2027 campaigns</span>
      <h1>One agency.<br /><span class="typewriter" data-typewriter aria-hidden="true" data-words='["Every channel.","Every campaign.","Every launch.","Every feed."]'>Every channel.</span><span class="sr-only">Every channel. Every campaign. Every launch. Every feed.</span></h1>
      <p class="hero-lede">A single accountable team for brands that need their digital presence to move as one, from first idea to final report.</p>
      <button type="button" class="button button-outline" data-inquiry-open>Start a conversation</button>
    </div>
    <div class="hero-art reveal reveal-delay" aria-label="Selected Dun Digital campaign work">
      <div class="hero-art-top"><span>Selected work</span><span>DD / 001</span></div>
      <div class="hero-mosaic" aria-hidden="true">
        {/* Single-format webp (plain <img>): CardSwap assigns img.src at runtime, which a <picture> would override. */}
        <figure class="mosaic-tile mosaic-main"><img src={(await getImage({ src: gRagam4, width: 960, formats: ['webp'] })).src} alt="" loading="eager" fetchpriority="high" decoding="async" width="960" data-cycle={[(await getImage({ src: gRagam0, width: 960, formats: ['webp'] })).src, (await getImage({ src: gRagam1, width: 960, formats: ['webp'] })).src].join('|')} /><figcaption>Brand systems · Raagam Polymound</figcaption></figure>
        <figure class="mosaic-tile"><img src={(await getImage({ src: gGuntupalli2, width: 800, formats: ['webp'] })).src} alt="" loading="eager" decoding="async" width="800" data-cycle={[(await getImage({ src: gGuntupalli0, width: 800, formats: ['webp'] })).src, (await getImage({ src: gGuntupalli3, width: 800, formats: ['webp'] })).src].join('|')} /><figcaption>Social & content · Guntupalli Marbles</figcaption></figure>
        <figure class="mosaic-tile"><img src={(await getImage({ src: gSummit0102, width: 800, formats: ['webp'] })).src} alt="" loading="lazy" decoding="async" width="800" data-cycle={[(await getImage({ src: gSummit0116, width: 800, formats: ['webp'] })).src, (await getImage({ src: gSummit0117, width: 800, formats: ['webp'] })).src].join('|')} /><figcaption>Live events · Industry summit</figcaption></figure>
      </div>
      <div class="hero-art-caption"><strong>Gateway to digital excellence</strong><span>Brand · Media · Culture</span></div>
    </div>
        <div class="hero-foot"><span>Eight service lines · One team</span><span>Chennai · India</span></div>
  </section>

  <section class="signal-band" aria-label="Dun Digital capabilities">
    <div class="signal-track" aria-hidden="true">
      <div class="signal-copy"><span>BRANDING</span><i><svg class="tick" aria-hidden="true"><use href="#i-spark" /></svg></i><span>SOCIAL</span><i><svg class="tick" aria-hidden="true"><use href="#i-spark" /></svg></i><span>ADVERTISING</span><i><svg class="tick" aria-hidden="true"><use href="#i-spark" /></svg></i><span>WEBSITES</span><i><svg class="tick" aria-hidden="true"><use href="#i-spark" /></svg></i><span>PR + INFLUENCER</span><i><svg class="tick" aria-hidden="true"><use href="#i-spark" /></svg></i><span>SHOOTS + EVENTS</span><i><svg class="tick" aria-hidden="true"><use href="#i-spark" /></svg></i></div>
      <div class="signal-copy"><span>BRANDING</span><i><svg class="tick" aria-hidden="true"><use href="#i-spark" /></svg></i><span>SOCIAL</span><i><svg class="tick" aria-hidden="true"><use href="#i-spark" /></svg></i><span>ADVERTISING</span><i><svg class="tick" aria-hidden="true"><use href="#i-spark" /></svg></i><span>WEBSITES</span><i><svg class="tick" aria-hidden="true"><use href="#i-spark" /></svg></i><span>PR + INFLUENCER</span><i><svg class="tick" aria-hidden="true"><use href="#i-spark" /></svg></i><span>SHOOTS + EVENTS</span><i><svg class="tick" aria-hidden="true"><use href="#i-spark" /></svg></i></div>
    </div>
  </section>

  <section class="intro section-wrap motion-section" id="about">
    <div class="intro-grid motion-reveal">
      <h2 class="h2-display">End-to-end, <em>by design.</em></h2>
      <div class="intro-copy"><p>Dun Digital was founded in 2024 so brands, institutions and industry bodies never have to stitch together separate vendors for design, media, PR and events again.</p><p>One partner. One team. One point of contact, with the discipline to make every channel pull in the same direction.</p><a class="text-link" href="/about/">Meet the team</a></div>
    </div>
    <div class="proof-row motion-reveal motion-stagger"><div><strong data-countup="30" data-suffix="+">30+</strong><span>Clients & campaigns</span></div><div><strong data-countup="12" data-suffix="+">12+</strong><span>Industries served</span></div><div><strong data-countup="10">10</strong><span>CII & industry summits</span></div><div><strong data-countup="8">8</strong><span>Service lines</span></div></div>
    <div class="sectors-head motion-reveal"><h2>One playbook. <em>Twelve sectors.</em></h2></div>
    <div class="industry-cloud intro-cloud">{industries.map((industry) => <span>{industry}</span>)}</div>
  </section>

  <section class="services section-wrap motion-section" id="services">
    <div class="section-heading motion-reveal"><span class="sticker sticker-bubble">What we do</span><h2>Everything under one roof.</h2><p>Brand, social, advertising, web, PR, creators, shoots and live events, moving as one.</p></div>
    <CapabilityList services={services} />
    <div class="method-strip motion-reveal">
      <h3>How every engagement runs.</h3>
      <div class="method-row motion-stagger">
        {method.map((item) => <div class="spot"><span>{item.step}</span><strong>{item.name}</strong><p>{item.note}</p></div>)}
      </div>
    </div>
  </section>

  <section class="work section-wrap motion-section" id="work">
    <div class="work-heading motion-reveal"><span class="sticker sticker-lime">Proof, not promises</span><h2>Selected work.</h2><p>From a 13-day delegate-generation sprint to a statewide public-awareness campaign, engagements are scoped around clear deliverables and real benchmarks.</p></div>
    <CaseStudyGrid cases={cases} />
  </section>

  <GallerySection frames={galleryFrames} />

  <section class="clients section-wrap motion-section" aria-label="Brands and institutions we've worked with">
    <p class="clients-label motion-reveal">Brands and institutions we've worked with</p>
    <ul class="client-wall motion-reveal motion-stagger">
      <li><img class="client-logo" src="/clients/cii.svg" alt="CII logo" width="120" height="36" loading="lazy" />CII</li>
      <li><img class="client-logo" src="/clients/tnpcb.png" alt="TN Pollution Control Board logo" width="120" height="40" loading="lazy" />TN Pollution Control Board</li>
      <li>Raagam Polymound</li>
      <li>Guntupalli Marbles</li>
      <li><img class="client-logo" src="/clients/east-coast.png" alt="East Coast Hospitals logo" width="150" height="40" loading="lazy" />East Coast Hospitals</li>
      <li><img class="client-logo" src="/clients/duggar.png" alt="Duggar Housing logo" width="120" height="40" loading="lazy" />Duggar Housing</li>
      <li>Comfort Point</li>
      <li>GPN Palace</li>
      <li>Jewel Box</li>
      <li>Reverge</li>
      <li>IPLAS (TAPMA)</li>
      <li>Evoke Media</li>
    </ul>
  </section>
</SiteLayout>

<script>
  // CardSwap: hero mosaic tiles cycle through same-client campaign photos.
  // Paused off-screen, in background tabs, and under reduced motion.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hero = document.querySelector('.hero');
  const cyclers = Array.from(document.querySelectorAll<HTMLImageElement>('.mosaic-tile img[data-cycle]')).map(
    (img) => ({ img, urls: (img.dataset.cycle ?? '').split('|').filter(Boolean), index: -1 }),
  );
  if (!reduceMotion && hero && cyclers.length > 0 && 'IntersectionObserver' in window) {
    let heroVisible = false;
    new IntersectionObserver((entries) => {
      heroVisible = entries[0].isIntersecting;
    }).observe(hero);
    const swapTile = (slot: { img: HTMLImageElement; urls: string[]; index: number }, delay: number) => {
      window.setTimeout(() => {
        if (!heroVisible || document.hidden) return;
        slot.index = (slot.index + 1) % slot.urls.length;
        const next = new Image();
        next.decoding = 'async';
        next.onload = () => {
          slot.img.style.opacity = '0';
          window.setTimeout(() => {
            slot.img.src = slot.urls[slot.index];
            slot.img.style.opacity = '1';
          }, 420);
        };
        next.src = slot.urls[slot.index];
      }, delay);
    };
    window.setInterval(() => {
      cyclers.forEach((slot, i) => swapTile(slot, i * 450));
    }, 4500);
  }
</script>
