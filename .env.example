# Canonical site URL used for <link rel="canonical">, OG tags and sitemap.
# Production: https://dundigital.in — override per-environment in your host dashboard.
PUBLIC_SITE_URL=https://dundigital.in

# Optional: POST inquiries as JSON { name, email, message, page, timestamp }.
# Leave empty to keep the drawer in demo/staged mode (no network call).
# Example (Formspree / Resend / custom API): https://forms.example.com/api/inquiry
PUBLIC_INQUIRY_ENDPOINT=

# Optional: paste the Google Forms embed URL here to render it on /contact.
# Example: https://docs.google.com/forms/d/e/FORM_ID/viewform?embedded=true
PUBLIC_GOOGLE_FORM_EMBED_URL=
